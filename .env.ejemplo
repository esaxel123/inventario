# Plantilla de credenciales y configuracion del proyecto inventario.
# COPIA este archivo como ".env" y cambia las contrasenas:
#   cp .env.ejemplo .env
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore) ni se
# incluye en capturas, bitacora o reporte.

# --- MySQL (la imagen oficial crea la BD y el usuario en el 1er inicio) ---
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASENA_ROOT
MYSQL_DATABASE=inventario_ct
MYSQL_USER=app_inventario
MYSQL_PASSWORD=CAMBIA_ESTA_CONTRASENA_APP

# --- Aplicacion ---
# Nombre de la organizacion que se muestra en el encabezado (Practica 11).
ORGANIZACION=Creation Technologies

# Clave de sesion de Flask: pon una cadena larga y aleatoria.
# Sin ella, las sesiones no sobreviven a un reinicio.
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA_LARGA

# Clave opcional del lector NFC. Si la dejas vacia, /api/retiro-nfc no
# exige cabecera. Si la defines, main.py debe enviarla (lo hace solo).
LECTOR_CLAVE=

# Puerto serial del lector NFC en el servidor (lector USB).
SERIAL_PORT=/dev/ttyUSB0
